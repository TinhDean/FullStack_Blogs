# Server Port (Render / Railway injects PORT automatically)
PORT=5000

# MongoDB Connection String (Atlas or Local)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/blogs?retryWrites=true&w=majority

# JWT Secret Key for token generation & verification
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Application URL for CORS in Production
FRONTEND_URL=http://localhost:3000

# Node Environment Mode (development / production / test)
NODE_ENV=development
